# Copy these names into Vercel → Project → Settings → Environment Variables.
# Never paste the real values into a chat or commit them to git.

# From developers.facebook.com → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# From your app → App settings → Basic → App secret (used to verify messages really come from Meta)
WHATSAPP_APP_SECRET=
# Any random word you invent; type the same word in Meta's webhook "Verify token" box
WHATSAPP_VERIFY_TOKEN=
# Your own WhatsApp number, country code + number, digits only (e.g. 919876543210). Only this number can use the agent.
OWNER_WHATSAPP=
# Optional: an approved template name for briefs when you haven't messaged the bot in 24h (e.g. hello_world)
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en_US

# From platform.claude.com → API keys
ANTHROPIC_API_KEY=
# Optional overrides
AI_MODEL=claude-opus-5-5
AI_EFFORT=medium

# Added automatically when you connect Upstash Redis from Vercel → Storage
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Random strings you invent (protect the scheduled briefs and your private tracker page)
CRON_SECRET=
STATUS_TOKEN=

TIMEZONE=Asia/Kolkata
