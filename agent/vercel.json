{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/*.js": { "maxDuration": 60 }
  },
  "crons": [
    { "path": "/api/cron?job=morning", "schedule": "30 3 * * *" },
    { "path": "/api/cron?job=evening", "schedule": "30 14 * * *" },
    { "path": "/api/cron?job=weekly", "schedule": "30 13 * * 0" }
  ]
}
