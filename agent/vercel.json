{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": { "maxDuration": 60, "includeFiles": "node_modules/ffmpeg-static/ffmpeg" }
  },
  "rewrites": [
    { "source": "/app", "destination": "/api/app" },
    { "source": "/status", "destination": "/api/status" },
    { "source": "/api/health", "destination": "/api/status" },
    { "source": "/", "destination": "/api/app" }
  ],
  "crons": [
    { "path": "/api/cron?job=morning", "schedule": "30 3 * * *" },
    { "path": "/api/cron?job=evening", "schedule": "30 13 * * *" },
    { "path": "/api/cron?job=weekly", "schedule": "0 4 * * 0" }
  ]
}
